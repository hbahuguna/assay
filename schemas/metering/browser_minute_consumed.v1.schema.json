{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/metering/browser_minute_consumed.v1.schema.json",
  "title": "browser_minute_consumed usage event v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "idempotency_key",
    "workspace",
    "run",
    "quantity",
    "unit",
    "timestamp",
    "source",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "quality-harness.metering/v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "browser_minute_consumed"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "unit": {
      "const": "browser_minute"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile"
          ]
        },
        "viewport": {
          "type": "string"
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": true
}
